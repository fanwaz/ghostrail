{
  "name": "@ghostrail/relayer",
  "version": "0.1.0",
  "private": true,
  "description": "Stateless Fastify relayer that validates and forwards signed GhostRail payments to Horizon testnet",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ghostrail/core": "workspace:*",
    "@stellar/stellar-sdk": "^17.2.1",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
