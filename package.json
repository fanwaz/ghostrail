{
  "name": "ghostrail",
  "private": true,
  "description": "Offline-first payments on Stellar testnet",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "pnpm --filter ./packages/* build",
    "test": "pnpm build && pnpm -r --if-present test",
    "test:testnet": "pnpm build && node scripts/test-testnet.mjs",
    "typecheck": "pnpm build && pnpm -r --if-present typecheck"
  }
}
